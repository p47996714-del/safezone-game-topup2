<script>
const token = localStorage.getItem('token');
if (!token) location.href = '/';
const H = {'Content-Type':'application/json','Authorization':token};
let products = [], selected = null, siteData = null, selectedPay = 'KBZ Pay';
let currentCategory = 'all', searchTerm = '', userData = {};
let deferredPrompt = null, lastUnread = 0, chatPoll = null, lastChatId = null;

setTimeout(() => {
  const s = document.getElementById('splash');
  if (s) { s.classList.add('hide'); setTimeout(() => s.remove(), 700); }
}, 2200);

const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;
let customAudio = new Audio();
function playSound(type){
  if (soundOn && siteData && siteData.customSound) { try { customAudio.src = siteData.customSound; customAudio.volume = 0.3; customAudio.play().catch(()=>{}); return; } catch(e){} }
  try {
    if (!audioCtx) audioCtx = new AudioCtx();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain); gain.connect(audioCtx.destination);
    if (type === 'success') { osc.frequency.setValueAtTime(800, audioCtx.currentTime); osc.frequency.exponentialRampToValueAtTime(1200, audioCtx.currentTime + 0.1); }
    else if (type === 'error') { osc.frequency.setValueAtTime(400, audioCtx.currentTime); osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.2); }
    else { osc.frequency.setValueAtTime(600, audioCtx.currentTime); }
    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
    osc.start(); osc.stop(audioCtx.currentTime + 0.2);
  } catch(e){}
}
function haptic(ms){ if (navigator.vibrate) navigator.vibrate(ms || 30); }
function showToast(text, type){
  const t = document.getElementById('toast');
  t.textContent = text;
  t.className = 'toast show ' + (type || '');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => {
    t.classList.remove('show');
    setTimeout(() => { t.textContent = ''; t.className = 'toast'; }, 400);
  }, 2000);
}
if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light'); document.getElementById('themeBtn').textContent = '☀️'; }
function toggleTheme(){
  document.body.classList.toggle('light');
  const isLight = document.body.classList.contains('light');
  document.getElementById('themeBtn').textContent = isLight ? '☀️' : '🌙';
  localStorage.setItem('theme', isLight ? 'light' : 'dark');
  haptic(20);
}
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferredPrompt = e; });
async function installPWA(){
  if (deferredPrompt) {
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === 'accepted') showToast('✅ App install ပြီးပါပြီ', 'success');
    deferredPrompt = null;
    return;
  }
  alert('📱 Install လုပ်နည်း:\n\n1. Chrome ⋮ menu နှိပ်\n2. "Add to Home screen" ရွေး\n3. "Add" နှိပ်\n\n✅ Home screen မှာ App လို ပေါ်မယ်');
}
if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(()=>{});


// Sound/Haptic toggles
let soundOn = localStorage.getItem('soundOn') !== 'off';
let hapticOn = localStorage.getItem('hapticOn') !== 'off';
function updateToggles(){
  const st = document.getElementById('soundToggle');
  const ht = document.getElementById('hapticToggle');
  if (st) st.classList.toggle('on', soundOn);
  if (ht) ht.classList.toggle('on', hapticOn);
}
function toggleSound(){ soundOn = !soundOn; localStorage.setItem('soundOn', soundOn?'on':'off'); updateToggles(); playSound('click'); haptic(20); }
function toggleHaptic(){ hapticOn = !hapticOn; localStorage.setItem('hapticOn', hapticOn?'on':'off'); updateToggles(); haptic(30); }

// Override playSound & haptic
const _origPlaySound = playSound;
playSound = function(type){ if (!soundOn) return; _origPlaySound(type); };
const _origHaptic = haptic;
haptic = function(ms){ if (!hapticOn) return; _origHaptic(ms); };

// Share
function shareApp(){
  const url = location.origin;
  if (navigator.share) {
    navigator.share({ title:'Safe Zone Game Topup', text:'\uD83C\uDFAE Safe Zone - Game Topup\n\uD83D\uDCB0 MLBB, PUBG, Magic Chess', url })
      .catch(()=>{});
  } else {
    navigator.clipboard.writeText(url).then(()=>showToast('\u2705 Link \u1000\u1030\u1038\u1015\u103C\u102E\u1038\u1015\u102B\u1015\u103C\u102E', 'success'));
  }
}

// Theme colors
const THEME_COLORS = [
  {name:'Blue', primary:'#38bdf8', secondary:'#a855f7'},
  {name:'Green', primary:'#10b981', secondary:'#3b82f6'},
  {name:'Red', primary:'#ef4444', secondary:'#f59e0b'},
  {name:'Pink', primary:'#ec4899', secondary:'#a855f7'},
  {name:'Orange', primary:'#f59e0b', secondary:'#ef4444'},
  {name:'Purple', primary:'#8b5cf6', secondary:'#ec4899'}
];
function openSettings(){
  document.getElementById('settingsModal').classList.add('show');
  updateToggles();
  const cur = localStorage.getItem('themeColor') || 'Blue';
  document.getElementById('themeColorRow').innerHTML = THEME_COLORS.map(c =>
    '<div class="theme-color-dot ' + (cur===c.name?'active':'') + '" style="background:linear-gradient(135deg,' + c.primary + ',' + c.secondary + ')" onclick="setThemeColor(\'' + c.name + '\')" title="' + c.name + '"></div>'
  ).join('');
}
function setThemeColor(name){
  const c = THEME_COLORS.find(x => x.name === name);
  if (!c) return;
  document.documentElement.style.setProperty('--accent1', c.primary);
  document.documentElement.style.setProperty('--accent2', c.secondary);
  localStorage.setItem('themeColor', name);
  document.querySelectorAll('button.main').forEach(b => b.style.background = 'linear-gradient(135deg,' + c.primary + ',' + c.secondary + ')');
  showToast('\u2705 ' + name + ' Theme', 'success');
  haptic(30);
}
function applyTheme(){
  const name = localStorage.getItem('themeColor') || 'Blue';
  setThemeColor(name);
}
applyTheme();

