async function api(url, opts={}) {
  const r = await fetch(url, {...opts, headers: {...H, ...(opts.headers||{})}});
  if (r.status === 401) { localStorage.clear(); location.href='/'; return {error:'unauth'}; }
  if (r.status === 403) { showToast('Account ပိတ်ထားသည်', 'error'); return {error:'banned'}; }
  return r.json();
}

