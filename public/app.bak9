async function loadSite(){
  siteData = await (await fetch('/api/site')).json();
  document.title = siteData.siteName;
  const car = document.getElementById('carousel');
  const dotsBox = document.getElementById('dots');
  siteData.banners.forEach((b,i) => {
    const div = document.createElement('div');
    div.className = 'slide' + (i===0?' active':'');
    div.style.background = b.bg;
    div.innerHTML = '<h3>' + b.title + '</h3><p>' + b.subtitle + '</p>';
    car.insertBefore(div, dotsBox);
    const dot = document.createElement('div');
    dot.className = 'dot' + (i===0?' active':'');
    dotsBox.appendChild(dot);
  });
  document.getElementById('payName').textContent = siteData.payName + ' — ' + siteData.payNumber;
  loadAdsBanner();
  const pays = (siteData.payments && siteData.payments.length) ? siteData.payments : [
    {name:'KBZ Pay', cls:'kbz', label:'KBZ'},
    {name:'Wave Money', cls:'wave', label:'Wave'},
    {name:'UAB Pay', cls:'uab', label:'UAB'},
    {name:'AYA Pay', cls:'aya', label:'AYA'}
  ];
  if (pays.length && !pays.find(p => p.name === selectedPay)) selectedPay = pays[0].name;
  document.getElementById('paymentList').innerHTML = pays.map(p=>{
    const logoHtml = p.image
      ? '<div class="pay-logo" style="background:#fff;padding:4px;overflow:hidden"><img src="' + p.image + '" style="width:100%;height:100%;object-fit:contain;border-radius:6px"></div>'
      : '<div class="pay-logo ' + (p.cls || 'kbz') + '">' + (p.short || p.label || p.name.substring(0, 4)) + '</div>';
    return '<div class="payment-method ' + (p.name===selectedPay?'selected':'') + '" onclick="selectPay(\'' + p.name + '\',this)">' +
      logoHtml +
      '<div class="pay-info"><div class="pay-name">' + p.name + '</div><div class="pay-num">' + siteData.payNumber + ' · ' + siteData.payName + '</div></div>' +
      '</div>';
  }).join('');
}
function selectPay(name, el){
  selectedPay = name;
  document.querySelectorAll('.payment-method').forEach(x=>x.classList.remove('selected'));
  el.classList.add('selected');
  haptic(15);
}
