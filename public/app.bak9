      <button onclick="installPWA()" id="pwaBtn" style="padding:10px 22px;background:rgba(16,185,129,0.15);color:#10b981;border:1.5px solid #10b981;border-radius:22px;font-weight:bold;font-size:14px;cursor:pointer;display:inline-block">📱 Install App</button>
    </div>
    <button onclick="logout()" style="width:100%;padding:13px;background:rgba(127,29,29,0.9);color:#fff;border:none;border-radius:12px;font-weight:bold">Logout</button>
  </div>
</div>

