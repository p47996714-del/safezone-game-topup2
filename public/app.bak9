// Typing indicator logic
let lastMsgCount = 0;
function checkTyping(list){
  const ind = document.getElementById('typingInd');
  if (!ind) return;
  // Show if last message from user and admin hasn't replied within 3s
  if (list.length && list[list.length-1].from === 'user' && Date.now() - list[list.length-1].createdAt < 3000) {
    ind.classList.add('show');
    setTimeout(() => ind.classList.remove('show'), 2500);
  }
}


// ===== LIVE STATS (Feature 13) =====
function animateNumber(el, target, dur) {
  if (!el) return;
  const start = parseInt(el.textContent) || 0;
  const startTime = Date.now();
  function tick() {
    const p = Math.min((Date.now() - startTime) / (dur || 1200), 1);
    const val = Math.floor(start + (target - start) * p);
    el.textContent = val.toLocaleString();
    if (p < 1) requestAnimationFrame(tick);
  }
  tick();
}
async function loadLiveStats() {
  try {
    const site = await (await fetch('/api/site')).json();
    const t = site.trustBadge || { users: 0, orders: 0, completed: 0 };
              } catch(e){}
}

// ===== GAME SLIDER (Feature 18) =====
function loadGameSlider() {
  const el = document.getElementById('gameSlider');
  if (!el) return;
  const imgs = siteData?.gameImages || {};
  const games = [...new Set(products.map(p => p.game))];
  const items = games.map(g => {
    const img = imgs[g] || 'https://via.placeholder.com/300x180/334155/38bdf8?text=Game';
    return '<div class="slider-card" onclick="openGameProducts(\'' + g.replace(/'/g, "\\'") + '\')">' +
      '<img src="' + img + '" onerror="this.src=\'https://via.placeholder.com/300x180/334155/38bdf8?text=Game\'">' +
      '<div class="title">' + g + '</div></div>';
  }).join('');
  el.innerHTML = items + items;
}

// ===== SMART RECOMMEND (Feature 22) =====
function getRecommendedGames() {
  const favs = JSON.parse(localStorage.getItem('favs') || '[]');
  const orderGames = {};
  (userData.orders || []).forEach(o => { orderGames[o.game] = (orderGames[o.game] || 0) + 1; });
  const scores = {};
  products.forEach(p => {
    let s = 0;
    if (favs.includes(p.game)) s += 5;
    if (orderGames[p.game]) s += orderGames[p.game] * 3;
    scores[p.game] = Math.max(scores[p.game] || 0, s);
  });
  return Object.entries(scores).sort((a, b) => b[1] - a[1]).slice(0, 3).map(x => x[0]);
}
function markRecommended() {
  const recs = getRecommendedGames();
  document.querySelectorAll('#gamesGrid .game-card').forEach(card => {
    const title = card.querySelector('.game-title')?.textContent || '';
    if (recs.includes(title) && !card.querySelector('.recommend-badge')) {
      const badge = document.createElement('div');
      badge.className = 'recommend-badge';
      badge.textContent = '⭐ For You';
      card.appendChild(badge);
    }
  });
}

// ===== BACKGROUND MUSIC (Feature 10) =====
let musicCtx = null;
let musicPlaying = false;
function startMusic() {
  try {
    if (musicCtx) { musicCtx.resume(); musicPlaying = true; updateMusicBtn(); return; }
    musicCtx = new (window.AudioContext || window.webkitAudioContext)();
    // Simple ambient chord progression
    const notes = [262, 330, 392, 523, 392, 330];
    let i = 0;
    const osc = musicCtx.createOscillator();
    const gain = musicCtx.createGain();
    osc.type = 'sine';
    osc.frequency.value = notes[0];
    osc.connect(gain);
    gain.connect(musicCtx.destination);
    gain.gain.value = 0.03;
    osc.start();
    const iv = setInterval(() => {
      if (!musicPlaying) return;
      i = (i + 1) % notes.length;
      try { osc.frequency.setValueAtTime(notes[i], musicCtx.currentTime); } catch(e){}
    }, 700);
    musicCtx._interval = iv;
    musicPlaying = true;
    updateMusicBtn();
  } catch(e){ console.log('music err', e.message); }
}
function stopMusic() {
  if (musicCtx) { try { musicCtx.suspend(); } catch(e){} }
  musicPlaying = false;
  updateMusicBtn();
}
function toggleMusic() {
  if (musicPlaying) stopMusic(); else startMusic();
  haptic(30);
}
function updateMusicBtn() {
  const b = document.getElementById('musicBtn');
  if (!b) return;
  b.textContent = musicPlaying ? '🎵' : '🔇';
  b.classList.toggle('playing', musicPlaying);
}

// ===== PUSH NOTIFICATION (Feature 9) =====
async function requestPushPermission() {
  if (!('Notification' in window)) return;
  if (Notification.permission === 'default') {
    try { await Notification.requestPermission(); } catch(e){}
  }
}
async function sendPush(title, body) {
  if (!('Notification' in window) || Notification.permission !== 'granted') return;
  try {
    if (navigator.serviceWorker && navigator.serviceWorker.controller) {
      const reg = await navigator.serviceWorker.ready;
      reg.showNotification(title, { body: body, icon: 'https://i.imgur.com/iRwIfqs.png', badge: 'https://i.imgur.com/iRwIfqs.png', vibrate: [200,100,200] });
    } else {
      new Notification(title, { body: body, icon: 'https://i.imgur.com/iRwIfqs.png' });
    }
  } catch(e){}
}

// ===== ANALYTICS (Feature 20) =====
function loadAnalytics() {
  const orders = userData.orders || [];
  const stats = {
    total: orders.length,
    spent: orders.filter(o => o.status === 'completed').reduce((s, o) => s + o.price, 0),
    points: userData.points || 0
  };
  animateNumber(document.getElementById('aOrders'), stats.total);
  const spentEl = document.getElementById('aSpent');
  if (spentEl) spentEl.textContent = (stats.spent / 1000).toFixed(1) + 'k';
  animateNumber(document.getElementById('aPoints'), stats.points);
  // 7-day chart
  const days = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date(); d.setDate(d.getDate() - i);
    const ds = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
    const de = ds + 86400000;
    const cnt = orders.filter(o => o.createdAt >= ds && o.createdAt < de).length;
    days.push({ label: d.toLocaleDateString('en', { weekday: 'short' }), value: cnt });
  }
  const max = Math.max(...days.map(x => x.value), 1);
  document.getElementById('userChartBars').innerHTML = days.map(x => {
    const hgt = Math.max(3, (x.value / max) * 100);
    return '<div class="chart-bar-wrap"><div class="chart-bar-val">' + (x.value || '') + '</div><div class="chart-bar" style="height:' + hgt + '%"></div><div class="chart-bar-lbl">' + x.label + '</div></div>';
  }).join('');
  // Top games
  const gm = {};
  orders.forEach(o => { gm[o.game] = (gm[o.game] || 0) + 1; });
  const top = Object.entries(gm).sort((a, b) => b[1] - a[1]).slice(0, 5);
  const tb = document.getElementById('topGamesBox');
  if (tb) {
    tb.innerHTML = top.length ? top.map(([g, c]) => '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #334155;font-size:13px"><span>' + g + '</span><b style="color:#38bdf8">' + c + ' orders</b></div>').join('') : '<div style="color:#64748b;font-size:12px">Order မရှိသေးပါ</div>';
  }
}

// ===== AUTO CHAT BOT (Feature 24) =====
const AUTO_REPLIES = {
  'hi': 'မင်္ဂလာပါ! 👋 Safe Zone မှ ကြိုဆိုပါတယ်',
  'hello': 'မင်္ဂလာပါ! 👋 ဘာကူညီပေးရမလဲ?',
  'မင်္ဂလာပါ': 'မင်္ဂလာပါ! 👋 ဘာကူညီပေးရမလဲ?',
  'deposit': 'Deposit ဖြည့်ရန် Wallet tab မှာ ဖြည့်ပါ။ 5-15 မိနစ်အတွင်း approve ဖြစ်မယ် ⏱',
  'order': 'Order တင်ရန် Home → ဂိမ်းရွေး → Player ID ထည့် → Order တင်ပါ 🎮',
  'balance': 'Balance ကြည့်ရန် Home မှာ ကြည့်နိုင်ပါတယ် 💰',
  'refund': 'Order Reject ဖြစ်ရင် Balance ကို auto ပြန်အမ်းပါတယ် ✅',
  'app premium': 'App Premium ဝယ်ရန် Admin ဆီ Telegram မှာ ဆက်သွယ်ပါ 📱',
};
function autoReply(text) {
  const lc = text.toLowerCase().trim();
  for (const k in AUTO_REPLIES) {
    if (lc.includes(k)) return AUTO_REPLIES[k];
  }
  return null;
}

// ===== ORDER SUCCESS SOUND (Feature 2) =====
function successSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [523, 659, 784, 1047].forEach((f, i) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.connect(g); g.connect(ctx.destination);
      o.frequency.value = f;
      o.type = 'sine';
      g.gain.setValueAtTime(0, ctx.currentTime + i * 0.1);
      g.gain.linearRampToValueAtTime(0.15, ctx.currentTime + i * 0.1 + 0.02);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.1 + 0.3);
      o.start(ctx.currentTime + i * 0.1);
      o.stop(ctx.currentTime + i * 0.1 + 0.3);
    });
  } catch(e){}
}
function errorSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const o = ctx.createOscillator(); const g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.frequency.setValueAtTime(300, ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(150, ctx.currentTime + 0.2);
    g.gain.setValueAtTime(0.15, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
    o.start(); o.stop(ctx.currentTime + 0.3);
  } catch(e){}
}

