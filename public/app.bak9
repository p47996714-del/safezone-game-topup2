  document.getElementById('ordList').innerHTML = d.length ? d.map(x=>`
    <div style="background:rgba(30,41,59,0.8);padding:14px;border-radius:14px;margin-bottom:10px;font-size:13px;border:1px solid #334155">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <b style="color:#38bdf8">${x.game}</b>
        <span class="status-badge status-${x.status}">${x.status}</span>
