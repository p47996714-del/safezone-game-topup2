      <div style="font-size:12px;color:#94a3b8;margin-top:4px">ID: ${x.playerId}${x.serverId?' · S:'+x.serverId:''} · ${x.price.toLocaleString()} Ks</div>
      <div class="progress-bar-wrap"><div class="progress-bar" data-stage="${x.status}"></div></div>
      <button onclick="reorder('${x.id}')" style="margin-top:8px;padding:8px 14px;background:rgba(56,189,248,0.15);color:#38bdf8;border:1px solid #38bdf8;border-radius:10px;font-size:12px;font-weight:bold;cursor:pointer">🔄 Reorder</button>
    </div>`).join('') : '<div class="empt...' + '' + 'y">မှတ်တမ်း မရှိပါ</div>';
}

async function loadChat(){
  const list = await api('/api/chat');
  if (list.error) return;
  const box = document.getElementById('chatMessages');
  box.innerHTML = list.length ? list.map(m=>{
    let html = '<div class="chat-bubble ' + m.from + '">';
    if (m.image) html += '<img src="' + m.image + '" style="max-width:100%;border-radius:8px">';
    html += (m.text ? escapeHtml(m.text) : '');
    html += '<div class="time">' + new Date(m.createdAt).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) + (m.from === 'user' ? renderReadReceipt(m) : '') + '</div>';
    html += '</div>';
    return html;
  }).join('') : '<div class="empty">Admin \u1006\u102E \u1005\u102C \u101B\u1031\u1038\u101C\u102D\u102F\u1037\u101B\u1015\u102B\u1015\u103C\u102E \uD83D\uDC4B</div>';
  const last = list[list.length-1];
  if (last && last.id !== lastChatId) { lastChatId = last.id; box.scrollTop = box.scrollHeight; }
  checkTyping(list);
}
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function sendChat(){
  const inp = document.getElementById('chatInput');
  const text = inp.value.trim();
  if (!text) return;
  inp.value = '';
  const r = await api('/api/chat', {method:'POST', body: JSON.stringify({text})});
  if (r.success) { loadChat(); haptic(20); }
}

function switchTab(name, btn){
  document.querySelectorAll('[id^="view-"]').forEach(v=>v.style.display='none');
  document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));
  document.getElementById('view-'+name).style.display='block';
  if (btn) btn.classList.add('active');
  haptic(15);
  if (name==='wallet') loadDeposits();
  if (name==='orders') loadOrders();
  if (name==='analytics') loadAnalytics();
  if (name==='chat') { loadChat(); lastChatId = null; if (chatPoll) clearInterval(chatPoll); chatPoll = setInterval(loadChat, 3000); }
  else { if (chatPoll) { clearInterval(chatPoll); chatPoll = null; } }
}
function gotoChat(){ switchTab('chat', document.querySelectorAll('.nav-item')[3]); }

function openGameProducts(game){
  const gProducts = products.filter(p=>p.game===game);
  const userVip = userData.vip || 'Bronze';
  const vipDisc = {Bronze:0, Silver:2, Gold:5, Diamond:8}[userVip] || 0;
  const list = gProducts.map(p=>{
    const final = Math.round(p.price * (1 - vipDisc/100));
    const disc = vipDisc > 0 ? `<div style="font-size:11px;color:#22c55e;margin-top:2px">-${vipDisc}% → ${final.toLocaleString()} Ks</div>` : '';
    return `<div class="game-card" onclick="openModal(${p.id})" style="cursor:pointer">
      <div style="padding:15px;text-align:center">
        <div style="font-size:26px">${p.image}</div>
        <div style="font-weight:bold;margin-top:5px;font-size:13px">${p.name}</div>
        <div style="color:#22c55e;margin-top:5px;font-weight:bold">${p.price.toLocaleString()} Ks</div>
        ${disc}
      </div></div>`;
  }).join('');
  document.getElementById('productModalBox').innerHTML = `
    <h3>${game} - ရွေးပါ</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">${list}</div>
    <button class="cancel" style="margin-top:15px" onclick="closeModal('productModal')">Close</button>`;
  document.getElementById('productModal').classList.add('show');
}
function openModal(id){
  selected = products.find(p=>p.id===id);
  closeModal('productModal');
  document.getElementById('mTitle').textContent = selected.name + ' - ' + selected.price.toLocaleString() + ' Ks';
  const pid = document.getElementById('playerId');
  const sf = document.getElementById('serverIdField');
  if (selected.game === 'App Premium') {
    pid.value = '';
    pid.placeholder = 'Your Email / Telegram / Phone';
    if (sf) sf.style.display = 'none';
  } else {
    pid.value = '';
    pid.placeholder = 'Player ID / UID';
    const needsServer = ['Mobile Legends', 'Magic Chess'].includes(selected.game);
    if (sf) sf.style.display = needsServer ? 'block' : 'none';
    const si = document.getElementById('serverId');
    if (si) si.value = '';
  }
  document.getElementById('orderModal').classList.add('show');
}
function closeModal(id){ document.getElementById(id).classList.remove('show'); }

async function submitOrder(){
  const playerId = document.getElementById('playerId').value.trim();
  const sf = document.getElementById('serverIdField');
  const serverId = (sf && sf.style.display !== 'none') ? document.getElementById('serverId').value.trim() : '';
  const isPremium = selected && selected.game === 'App Premium';

  if (!playerId) return showToast(isPremium ? 'Email / Telegram ဖြည့်ပါ' : 'Player ID ဖြည့်ပါ', 'error');
  if (!isPremium && sf && sf.style.display !== 'none' && !serverId) return showToast('Server ID ဖြည့်ပါ', 'error');

  // Check balance before order
  if ((userData.balance || 0) < selected.price) {
    return showToast('❌ Balance မလုံလောက်ပါ (' + selected.price.toLocaleString() + ' Ks လိုတယ်)', 'error');
  }

  let confirmMsg;
  if (isPremium) {
    confirmMsg = '📱 App Premium ဝယ်မလား?\n\n' +
      '📦 ' + selected.name + '\n' +
      '💵 ' + selected.price.toLocaleString() + ' Ks\n' +
      '📧 ' + playerId + '\n\n' +
      '⚠️ Balance က ချက်ချင်း ဖြတ်မယ်';
  } else {
    confirmMsg = '🎮 Order တင်မလား?\n\n' +
      '🎮 ' + selected.game + '\n' +
      '📦 ' + selected.name + '\n' +
      '💵 ' + selected.price.toLocaleString() + ' Ks\n' +
      '🆔 ' + playerId + (serverId ? ' • S:' + serverId : '');
  }

  if (!confirm(confirmMsg)) return;

  const body = { productId: selected.id, playerId: playerId };
  if (!isPremium) body.serverId = serverId;

  const d = await api('/api/order', { method: 'POST', body: JSON.stringify(body) });
  if (d.success) {
    successSound(); haptic(100); confetti();
    sendPush('Order တင်ပြီး', selected.game + ' - ' + selected.name);
    showToast('✅ Order တင်ပြီးပါပြီ', 'success');
    closeModal('orderModal');
    loadMe(); loadOrders();
    if (isPremium) {
      setTimeout(function(){ alert('✅ Order ရောက်ပါပြီ\n\n📱 Admin က မကြာမီ ဆောင်ရွက်ပေးပါမယ်\n\nOrder ID: ' + d.orderId); }, 500);
    }
  } else {
    errorSound(); showToast('❌ ' + d.error, 'error');
  }
}
async function reorder(orderId){
  if (!confirm('ဒီ order ကို ပြန်မှာမှာလား?')) return;
  const d = await api('/api/reorder', {method:'POST', body: JSON.stringify({orderId})});
  if (d.success) { showToast('✅ Reorder ပြီးပါပြီ', 'success'); loadMe(); loadOrders(); }
  else showToast('❌ ' + d.error, 'error');
}

function previewReceipt(input){
  const file = input.files[0];
  if (!file) return;
  if (file.size > 2 * 1024 * 1024) { showToast('ပုံ 2MB အောက်သာ', 'error'); input.value = ''; return; }
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('receiptImg').src = e.target.result;
    document.getElementById('receiptPreview').style.display = 'block';
  };
  reader.readAsDataURL(file);
}
async function deposit(){
  const amount = document.getElementById('dAmt').value;
  if (!amount || amount < 1000) return showToast('အနည်းဆုံး 1000 Ks', 'error');
  let receipt = null;
  const preview = document.getElementById('receiptPreview');
  const img = document.getElementById('receiptImg');
  if (preview && preview.style.display !== 'none' && img && img.src) receipt = img.src;
  const d = await api('/api/deposit', {method:'POST', body: JSON.stringify({amount, method:selectedPay, receipt})});
  if (d.success){
    playSound('success'); haptic(60);
    showToast('✅ ' + d.message, 'success');
    document.getElementById('dAmt').value='';
    document.getElementById('receiptInput').value='';
    preview.style.display='none';
    loadDeposits();
  } else { playSound('error'); showToast('❌ ' + d.error, 'error'); }
}

function openCoupon(){
  document.getElementById('couponCode').value = '';
  document.getElementById('couponModal').classList.add('show');
  setTimeout(() => document.getElementById('couponCode').focus(), 300);
}
async function redeemCoupon(){
  const code = document.getElementById('couponCode').value.trim();
  if (!code) return showToast('Code ရိုက်ပါ', 'error');
  const d = await api('/api/redeem-coupon', {method:'POST', body: JSON.stringify({code})});
  if (d.success) {
    playSound('success'); haptic(60); confetti();
    showToast('✅ +' + d.reward.toLocaleString() + ' Ks!', 'success');
    closeModal('couponModal'); loadMe();
  } else { playSound('error'); showToast('❌ ' + d.error, 'error'); }
}

async function openLeaderboard(){
  const list = await api('/api/leaderboard');
  const medals = ['🥇','🥈','🥉'];
  document.getElementById('leaderBox').innerHTML = list.length ? list.map((u,i)=>`
    <div style="display:flex;justify-content:space-between;padding:12px;background:rgba(15,23,42,0.6);border-radius:12px;margin-bottom:8px;border:1px solid #334155">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:20px;width:28px">${medals[i]||('#'+(i+1))}</span>
        <div><b style="color:#38bdf8">${u.username}</b><div style="font-size:10px"><span class="vip-badge vip-${u.vip}">${u.vip}</span></div></div>
      </div>
      <b style="color:#22c55e">${u.total.toLocaleString()} Ks</b>
    </div>`).join('') : '<div class="empty">ဒေတာ မရှိပါ</div>';
  document.getElementById('leaderModal').classList.add('show');
}

const ACH_DEFS = {
  first_order: {icon:'🎯', name:'First Order', desc:'ပထမဆုံး ဝယ်ပြီးပါပြီ'},
  ten_orders: {icon:'🔟', name:'10 Orders', desc:'၁၀ ခါ ဝယ်ပြီးပါပြီ'},
  big_spender: {icon:'💎', name:'Big Spender', desc:'100,000 Ks ဝယ်ပြီးပါပြီ'}
};
function openAchievements(){
  const achs = userData.achievements || [];
  document.getElementById('achBox').innerHTML = Object.keys(ACH_DEFS).map(k => {
    const has = achs.includes(k); const d = ACH_DEFS[k];
    return `<div style="display:flex;gap:12px;padding:14px;background:${has?'rgba(34,197,94,0.1)':'rgba(15,23,42,0.6)'};border-radius:12px;margin-bottom:10px;border:1px solid ${has?'#22c55e':'#334155'};opacity:${has?1:0.5}">
      <div style="font-size:32px">${d.icon}</div>
      <div><div style="font-weight:bold;font-size:14px">${d.name}</div><div style="font-size:12px;color:#94a3b8;margin-top:3px">${d.desc}</div></div>
    </div>`;
  }).join('');
  document.getElementById('achModal').classList.add('show');
}

async function openNotif(){
  playSound('click'); haptic(20);
  document.getElementById('notifModal').classList.add('show');
  document.getElementById('notifList').innerHTML = '<div class="empty">Loading...</div>';
  try {
    let list = [];
    try {
      const r = await fetch('/api/notifications', {headers: H});
      if (r.ok) { const j = await r.json(); if (Array.isArray(j)) list = j; }
    } catch(e){}
    if (!list.length) {
      try {
        const chat = await api('/api/chat');
        if (Array.isArray(chat)) {
          list = chat.slice(-30).reverse().map(m => ({
            message: (m.from === 'admin' ? '\u{1F468}\u200D\u{1F4BC} Admin: ' : '\u{1F464} You: ') + (m.text || '[\u{1F4F7} Image]'),
            createdAt: m.createdAt,
            read: m.from === 'user'
          }));
        }
      } catch(e){}
    }
    document.getElementById('notifList').innerHTML = list.length ? list.map(n=>
      '<div style="padding:14px;background:' + (n.read ? 'rgba(15,23,42,0.4)' : 'rgba(56,189,248,0.08)') + ';border-radius:12px;margin-bottom:8px;border:1px solid ' + (n.read ? '#334155' : '#38bdf8') + '">' +
      '<div style="font-size:13px">' + escapeHtml(n.message) + '</div>' +
      '<div style="font-size:11px;color:#64748b;margin-top:5px">' + new Date(n.createdAt).toLocaleString() + '</div>' +
      '</div>'
    ).join('') : '<div class="empty">Notification \u1019\u101B\u103E\u102B\u1015\u102B</div>';
    if (list.length && list.some(x => !x.read)) {
      try { await fetch('/api/notifications/read', {method:'POST', headers: H}); } catch(e){}
    }
    loadMe();
  } catch(e) {
    document.getElementById('notifList').innerHTML = '<div class="empty">\u1019\u101B\u103E\u102B\u1015\u102B</div>';
  }
}

function copyRef(){
  const code = userData.referralCode || '';
  navigator.clipboard.writeText(code).then(()=>showToast('✅ ' + code, 'success')).catch(()=>showToast('Code: ' + code, 'info'));
}
function openTerms(){ window.open('/terms.html', '_blank'); }

const TOUR_STEPS = [
  { icon:'👋', title:'Safe Zone မှ ကြိုဆိုပါတယ်!', text:'Game Topup လုပ်နည်း လမ်းညွှန်ပြပါမယ်။' },
  { icon:'💰', title:'Step 1: Wallet ဖြည့်', text:'ငွေဖြည့် tab မှာ ဖြည့်ပါ။' },
  { icon:'🎮', title:'Step 2: ဂိမ်း ရွေး', text:'ဂိမ်း ရွေးပြီး Order တင်ပါ။' },
  { icon:'⚡', title:'Step 3: ချက်ချင်း ရ', text:'Admin approve ပြီးရင် ရပါပြီ!' }
];
let tourIdx = 0;
function startTour(){
  if (localStorage.getItem('tourSeen')) return;
  tourIdx = 0; updateTour();
  document.getElementById('tour').classList.add('show');
}
function updateTour(){
  const s = TOUR_STEPS[tourIdx];
  document.getElementById('tourIcon').textContent = s.icon;
  document.getElementById('tourTitle').textContent = s.title;
  document.getElementById('tourText').textContent = s.text;
  document.querySelector('.tour-next').textContent = tourIdx === TOUR_STEPS.length-1 ? 'ပြီးပါပြီ' : 'Next';
}
function nextTour(){
  tourIdx++;
  if (tourIdx >= TOUR_STEPS.length) return endTour();
  updateTour(); haptic(15);
}
function endTour(){
  document.getElementById('tour').classList.remove('show');
  localStorage.setItem('tourSeen', '1');
  haptic(30);
}
function confetti(){
  const colors = ['#38bdf8','#a855f7','#f59e0b','#22c55e','#ec4899'];
  for (let i = 0; i < 30; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + '%';
    c.style.top = '-10px';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.animationDelay = Math.random() * 0.5 + 's';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 3500);
  }
}

function openFaq(){ switchTab('faq', document.querySelector('.nav-item')); }
function openStats(){ switchTab('analytics', document.querySelector('.nav-item')); }
async function logout(){
  if (!confirm('Logout လုပ်မှာသေချာလား?')) return;
  await api('/api/logout', {method:'POST'});
  localStorage.clear(); location.href = '/';
}

(async () => {
  await checkMaint();
  await loadSite();
  await loadMe();
  await loadProducts();
  requestPushPermission();
  setTimeout(startTour, 2500);
  setInterval(loadMe, 15000);
  setInterval(async () => {
    try {
      const d = await api('/api/me');
      if (d.unread > 0) {
        const b = document.getElementById('notifBadge');
        b.textContent = d.unread;
        b.style.display = 'inline-block';
        if (d.unread > lastUnread) { playSound('success'); haptic(50); showToast('🔔 Notification အသစ်', 'info'); }
      } else {
        document.getElementById('notifBadge').style.display = 'none';
      }
      lastUnread = d.unread || 0;
    } catch(e){}
  }, 10000);
})();
</script>
</body>
</html>
