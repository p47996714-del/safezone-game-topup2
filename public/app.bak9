async function loadProducts(){
  showSkeletons();
  products = await api('/api/products');
  renderGames();
  loadGameSlider();
  setTimeout(markRecommended, 300);
}
function renderGames(){
  const games = [...new Set(products.map(p => p.game))];
  const imgs = siteData?.gameImages || {};
  const favs = JSON.parse(localStorage.getItem('favs') || '[]');
  let filtered = games.filter(g => {
    if (searchTerm && !g.toLowerCase().includes(searchTerm.toLowerCase())) return false;
    if (currentCategory !== 'all') {
      const p = products.find(x => x.game === g);
      if (!p || p.category !== currentCategory) return false;
    }
    return true;
  });
  document.getElementById('gamesGrid').innerHTML = filtered.map(g => {
    const img = imgs[g] || 'https://via.placeholder.com/200x120/334155/38bdf8?text=Game';
    const isFav = favs.includes(g);
    return `<div class="game-card" onclick="openGameProducts('${g.replace(/'/g,"\\'")}')">
      <button class="fav-btn" onclick="event.stopPropagation();toggleFav('${g.replace(/'/g,"\\'")}',this)">${isFav?'❤️':'🤍'}</button>
      <img class="game-img" src="${img}" alt="${g}" onerror="this.src='https://via.placeholder.com/200x120/334155/38bdf8?text=Game'">
      <div class="game-title">${g}</div></div>`;
  }).join('') || '<div class="empty" style="grid-column:1/-1">ဂိမ်း မတွေ့ပါ</div>';
}
function filterGames(){ searchTerm = document.getElementById('searchInput').value; renderGames(); }
function setCategory(cat, el){
  currentCategory = cat;
  document.querySelectorAll('.category-tabs button').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  haptic(15);
  renderGames();
}
function toggleFav(game, el){
  const favs = JSON.parse(localStorage.getItem('favs') || '[]');
  const idx = favs.indexOf(game);
  if (idx >= 0) { favs.splice(idx,1); el.textContent='🤍'; }
  else { favs.push(game); el.textContent='❤️'; showToast('⭐ Favorite', 'info'); }
  localStorage.setItem('favs', JSON.stringify(favs));
  haptic(20);
}

